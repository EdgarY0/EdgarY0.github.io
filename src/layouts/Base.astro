---
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site } from "../config";
import { LANGS, type Lang, type NavPage, ogLocale, routes } from "../i18n/lang";
import { t } from "../i18n/ui";

interface Props {
	lang: Lang;
	/** Título da página; sem ele, fica só o nome do blog. */
	title?: string | undefined;
	description?: string | undefined;
	/** Esta mesma página em cada idioma — vira hreflang e o destino do PT | EN. */
	alternates?: Partial<Record<Lang, string>> | undefined;
	current?: NavPage | undefined;
	article?: { published: Date; tags: readonly string[] } | undefined;
}

const { lang, title, description, alternates = {}, current, article } = Astro.props;

const pageTitle = title === undefined ? site.title : `${title} · ${site.title}`;
const pageDescription = description ?? site.tagline[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);

// hreflang só faz sentido quando a página existe nos dois idiomas.
const translations = LANGS.flatMap((code) => {
	const href = alternates[code];
	return href === undefined ? [] : [{ code, href: new URL(href, Astro.site).href }];
});
const xDefault = translations.find((translation) => translation.code === "pt-BR");
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="author" content={site.author} />
		<meta name="theme-color" content={site.themeColor} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		{
			translations.length > 1 &&
				translations.map((translation) => (
					<link rel="alternate" hreflang={translation.code} href={translation.href} />
				))
		}
		{
			translations.length > 1 && xDefault !== undefined && (
				<link rel="alternate" hreflang="x-default" href={xDefault.href} />
			)
		}
		<link rel="alternate" type="application/rss+xml" title={site.title} href={routes.rss[lang]} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:site_name" content={site.title} />
		<meta property="og:type" content={article === undefined ? "website" : "article"} />
		<meta property="og:title" content={title ?? site.title} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale(lang)} />
		{
			article !== undefined && (
				<meta property="article:published_time" content={article.published.toISOString()} />
			)
		}
		{article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<meta name="twitter:card" content="summary" />

		<Font cssVariable="--font-mono" preload={[{ weight: 400, style: "normal" }]} />
		{
			// O índice da busca só existe depois do build (pagefind --site dist); no dev os arquivos não existem.
			import.meta.env.PROD && (
				<>
					<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
					<script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
				</>
			)
		}
	</head>
	<body>
		<a class="skip-link" href="#conteudo">{t(lang, "skip")}</a>
		<div class="page">
			<Header lang={lang} alternates={alternates} current={current} />
			<main id="conteudo">
				<slot />
			</main>
		</div>
		<Footer lang={lang} />
		<pagefind-modal></pagefind-modal>
	</body>
</html>
