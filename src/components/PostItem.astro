---
import type { Lang } from "../i18n/lang";
import { t } from "../i18n/ui";
import type { Post } from "../lib/content";
import { formatDate } from "../lib/posts";
import TagList from "./TagList.astro";

interface Props {
	post: Post;
	lang: Lang;
	headingTag?: "h2" | "h3";
}

const { post, lang, headingTag: Heading = "h3" } = Astro.props;
---

<article class="post-item">
	<Heading class="post-title"><a href={post.url}>{post.title}</a></Heading>
	<p class="post-meta">
		<time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date, lang)}</time>{" "}
		<span aria-hidden="true">·</span> <span>{t(lang, "post.minutes", { n: post.minutes })}</span>
		{post.draft && <span class="draft">[{t(lang, "draft")}]</span>}
	</p>
	<TagList tags={post.tags} lang={lang} />
	<p class="post-description">{post.description}</p>
</article>

<style>
	.post-item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.75rem 1rem 0.85rem 2rem;
		border: var(--border) solid transparent;
		transition:
			border-color 0.1s ease,
			box-shadow 0.1s ease;
	}

	/* O ">" é o prompt do terminal; fica fora do leitor de tela. */
	.post-title::before {
		content: ">" / "";
		position: absolute;
		left: -1.15rem;
	}

	.post-item:hover,
	.post-item:focus-within {
		border-color: var(--fg);
		box-shadow: inset 0 0 8px var(--glow);
	}

	/* No HTML o título vem primeiro (navegação por títulos); na tela, a data vai em cima. */
	.post-meta {
		order: -1;
	}

	.post-title {
		position: relative;
		margin: 0;
		font-size: var(--font-size-base);
		font-weight: 700;
		line-height: 1.4;
	}

	.post-title a {
		text-decoration-thickness: 2px;
	}

	.post-description {
		max-width: 72ch;
		margin: 0.15rem 0 0;
		font-size: var(--font-size-sm);
	}
</style>
