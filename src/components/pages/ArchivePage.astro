---
import { type Lang, routes } from "../../i18n/lang";
import { t } from "../../i18n/ui";
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../lib/content";
import { formatDate, groupByMonth } from "../../lib/posts";
import Frame from "../Frame.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const months = groupByMonth(await getPosts(lang), lang);
---

<Base
	lang={lang}
	title={t(lang, "archive.title")}
	description={t(lang, "archive.description")}
	alternates={routes.archive}
	current="archive"
>
	<Frame label={t(lang, "archive.title")} labelTag="h1">
		{months.length === 0 && <p>{t(lang, "home.empty")}</p>}
		{
			months.map((month) => (
				<section class="month" id={month.key}>
					<h2 class="month-title">{month.label}</h2>
					<ul class="archive-list">
						{month.posts.map((post) => (
							<li>
								<time datetime={post.date.toISOString().slice(0, 10)}>
									{formatDate(post.date, lang)}
								</time>{" "}
								<a href={post.url}>{post.title}</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</Frame>
</Base>

<style>
	.month + .month {
		margin-top: 1.75rem;
	}

	.month-title {
		margin: 0 0 0.75rem;
		font-size: var(--font-size-base);
	}

	.month-title::before {
		content: "> " / "";
	}

	.archive-list {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0 0 0 1.25rem;
		list-style: none;
	}

	.archive-list li {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5ch;
	}

	.archive-list time {
		color: var(--fg-dim);
		font-size: var(--font-size-sm);
		line-height: 1.75;
	}
</style>
